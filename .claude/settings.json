{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": [],
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.git/**)",
      "Bash(sudo *)",
      "Bash(*exec*)",
      "Bash(git push *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(*chmod*)",
      "Bash(ssh *)"
    ],
    "ask": [
      "Bash"
    ]
  }
}
