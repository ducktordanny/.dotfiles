{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "effortLevel": "xhigh",
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "editorMode": "vim",
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "cleanupPeriodDays": 365,
  "permissions": {
    "allow": ["Bash"],
    "deny": [
      "Bash(*chmod*)",
      "Bash(*exec*)",
      "Bash(git *)",
      "Bash(rm -fr *)",
      "Bash(rm -rf *)",
      "Bash(ssh *)",
      "Bash(sudo *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(./.git/**)",
      "Read(~/.ssh/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/lib/claude-notify.sh" }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "command", "command": "~/.claude/lib/claude-notify.sh" }
        ]
      }
    ]
  }
}
